# Example environment for local development.
#
# Copy this file and fill in the values for your setup:
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.

# ── Public URLs ─────────────────────────────────────────────────────────────
# Browser-facing origin of the portal. Relative PUBLIC_* paths below are
# resolved against this value (see getUrlEnv in src/utils/env.ts).
PUBLIC_SERVER=http://localhost:4321

# Absolute URL to the genomics API as seen by the browser. Optional: when empty
# it is derived from PUBLIC_APIS_BASE_URL as
#   $PUBLIC_SERVER/api/genomicsservice/v1
PUBLIC_API_GENOMICS_SERVICE=

# Same-origin paths. The values shown are the built-in defaults; uncomment and
# change them only when your deployment mounts these somewhere else.
# PUBLIC_APIS_BASE_URL=/api
# PUBLIC_DOWNLOAD_URL=/download/
# PUBLIC_UI_PAGE_GENOMEBROWSER=/jbrowse/
# PUBLIC_UI_PAGE_BLAST=/blast/
# PUBLIC_UI_PAGE_API_DOC=/api/genomicsservice/v1/docs

# ── Internal (server-to-server) URLs ────────────────────────────────────────
# Absolute URLs used for requests made from the server. Optional: when empty
# they fall back to the matching PUBLIC_* URL, which is fine for local
# development against a stack on localhost. In Docker, set them so containers
# reach each other by service name instead of through the public hostname.
# INTERNAL_API_GENOMICS_SERVICE=http://genomicsservice:8080
# INTERNAL_KEYCLOAK_ISSUER=http://keycloak:8080/realms/example-realm

# ── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TRUST_HOST=true

# ── Keycloak (OIDC) ────────────────────────────────────────────────────────
KEYCLOAK_ISSUER=http://localhost:8080/realms/example-realm
KEYCLOAK_CLIENT_ID=example-portal-client
KEYCLOAK_CLIENT_SECRET=replace-with-your-client-secret

# Optional. Issuer claim expected in tokens, when it differs from the URL used
# to reach Keycloak (e.g. browser and server see different hostnames).
# KEYCLOAK_VALID_ISSUER=
