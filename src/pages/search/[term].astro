---
import Layout from "@/layouts/default.astro";
import SearchResult from "@/components/pages/search/SearchResult";
import genomicsService, {
  type AssemblyVersionDetail,
  type GeneSearchResult,
} from "@/utils/services/genomics";
import { getCurrentVersionName } from "@/utils/currentVersion";

const { term = "" } = Astro.params;

const { search, fetchVersionDetail } = genomicsService();

const currentVersionName = await getCurrentVersionName();

const [searchResult, assemblyList] = await Promise.all([
  search(term, { version: currentVersionName }).catch((e) => {
    console.error("Search failed:", e);
    return {} as GeneSearchResult;
  }),
  currentVersionName
    ? fetchVersionDetail(currentVersionName)
        .then((detail) => detail.data.assemblies ?? [])
        .catch((e) => {
          console.error("Failed to fetch assemblies:", e);
          return [] as AssemblyVersionDetail[];
        })
    : Promise.resolve([] as AssemblyVersionDetail[]),
]);

const searchData = searchResult;
const assemblies = assemblyList;
---

<Layout title={`Search: ${term} - EMOBase`}>
  <div class="w-full max-w-7xl mx-auto px-4 py-8 flex flex-col gap-8">
    <div class="flex flex-col gap-8 animate-in fade-in duration-500">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-slate-500 mb-1">
            Search results for:
          </p>
          <h1 class="text-3xl font-display font-bold text-slate-900">
            {term}
          </h1>
        </div>
      </div>
      <SearchResult
        term={term}
        searchData={searchData}
        assemblies={assemblies}
        version={currentVersionName}
        client:load
      />
    </div>
  </div>
</Layout>
